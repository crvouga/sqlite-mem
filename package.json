{
  "name": "sqlite-mem",
  "version": "0.1.0",
  "description": "Pure TypeScript in-memory SQLite implementation with zero WASM/native dependencies",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "COMPATIBILITY.md",
    "COMPATIBILITY-AUDIT.md",
    "README.md",
    "LICENSE",
    "compat"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test tests/contract tests/fuzz tests/harness",
    "test:contract": "bun test tests/contract",
    "test:fuzz": "bun test tests/fuzz",
    "test:browser": "bun run tests/browser/run.ts",
    "benchmark": "bun run benchmarks/run.ts --tier default --engine mem",
    "benchmark:bun": "bun run benchmarks/run.ts --tier full --engine both",
    "benchmark:browser": "bun run benchmarks/browser/run.ts --tier ci --mobile-tier ci",
    "benchmark:ci": "bun run benchmarks/run.ts --tier ci --engine mem --out benchmarks/results/ci-latest.json && bun run benchmarks/compare-ci.ts",
    "benchmark:bundle": "bun run build && bun run benchmarks/bundle.ts",
    "test:sqlite-compat": "bun run scripts/sqlite-requirements.ts && bun run scripts/sqlite-compat-gate.ts && bun test tests/contract tests/fuzz tests/harness",
    "inventory": "bun run scripts/sqlite-inventory.ts",
    "fts-surface": "bun run scripts/fts-oracle-surface.ts",
    "requirements": "bun run scripts/sqlite-requirements.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "clean": "rm -rf dist",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:sqlite-compat"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "latest",
    "esbuild": "^0.28.2",
    "fast-check": "^4.1.1",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "sqlite",
    "typescript",
    "in-memory",
    "database",
    "sql"
  ]
}
